# Copy to .env ONLY on the Linux server. Replace every REPLACE_WITH value.
# APP_DOMAIN is a hostname without https:// or a trailing slash.
APP_DOMAIN=crm.example.com
ACME_EMAIL=admin@example.com

# Use a random hexadecimal password (64 characters), safe in DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
DATABASE_URL=postgresql://iz:REPLACE_WITH_64_RANDOM_HEX_CHARACTERS@db:5432/iz
# Preserve the existing authentication secret during migration, or generate a new one.
BETTER_AUTH_SECRET=REPLACE_WITH_AUTH_SECRET_AT_LEAST_32_CHARACTERS
BETTER_AUTH_URL=https://crm.example.com

S3_ENDPOINT=http://storage:9000
S3_REGION=us-east-1
# Use the same bucket name and object keys as in the existing installation.
S3_BUCKET=iz-documents
S3_ACCESS_KEY_ID=REPLACE_WITH_STORAGE_USER
S3_SECRET_ACCESS_KEY=REPLACE_WITH_RANDOM_STORAGE_PASSWORD
CLAMAV_HOST=scanner
CLAMAV_PORT=3310

# Resend SMTP example. Verify the sending domain before sending invitations.
SMTP_HOST=smtp.resend.com
SMTP_PORT=2587
SMTP_USER=resend
SMTP_PASSWORD=REPLACE_WITH_SMTP_API_KEY
MAIL_FROM=Project Iz <no-reply@example.com>

# Keep Telegram blank until the local receiver has been stopped.
# Enable the telegram Compose profile only after migration and verification.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BACKUP_CHAT_ID=
TELEGRAM_TEAM_CHAT_ID=
TELEGRAM_FINANCE_CHAT_ID=
